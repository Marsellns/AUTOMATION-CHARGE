APP_NAME=SIMASTER
APP_ENV=production
# Pindahkan APP_KEY lama secara privat jika database lama ikut dipindahkan.
APP_KEY=
APP_DEBUG=false
APP_URL=https://simaster.example.com
APP_FORCE_HTTPS=true
# Isi hanya IP/CIDR reverse proxy hosting bila memang dipakai.
TRUSTED_PROXIES=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANELUSER_simaster
DB_USERNAME=CPANELUSER_simaster
DB_PASSWORD="GANTI_PASSWORD_DATABASE"

SESSION_DRIVER=database
SESSION_COOKIE=simaster_report_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
CACHE_STORE=database
CACHE_PREFIX=simaster_production_
# Notifikasi saat ini berjalan sinkron; shared hosting tidak perlu daemon worker.
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

MAIL_MAILER=smtp
# smtp + port 587 memakai STARTTLS; gunakan smtps + 465 jika diwajibkan hosting.
MAIL_SCHEME=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME="GANTI_USER_SMTP"
MAIL_PASSWORD="GANTI_PASSWORD_SMTP"
MAIL_FROM_ADDRESS="simaster@example.com"
MAIL_FROM_NAME="${APP_NAME}"
ELECTRICITY_ALERT_EMAIL=
INFRASTRUCTURE_ALERT_EMAIL=
SITE_LOSS_ALERT_EMAIL=
NOTIFICATION_DAILY_AT=08:00
NOTIFICATION_EVENING_AT=17:00
NOTIFICATION_TIMEZONE=Asia/Jakarta

# Hanya untuk database baru tanpa admin. Hapus kembali sebelum optimize.
SIMASTER_INITIAL_ADMIN_NAME=
SIMASTER_INITIAL_ADMIN_EMAIL=
SIMASTER_INITIAL_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
