  <diagram id="p1" name="1. Domain PnL Site">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d1_regions" value="&lt;b&gt;regions&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id : BIGINT UNSIGNED AUTO_INCREMENT&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; kode : VARCHAR(10) NOT NULL — prefix site ID (TNG/BKS/BDB)&lt;br&gt;nama : VARCHAR(255) NULL — nama wilayah, diisi manual&lt;br&gt;created_at / updated_at : TIMESTAMP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="380" height="140" as="geometry" /></mxCell>
        <mxCell id="d1_sites" value="&lt;b&gt;sites&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id : BIGINT UNSIGNED AUTO_INCREMENT&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; site_id : VARCHAR(20) NOT NULL — ID dari Excel (BDB001, TNG735)&lt;br&gt;site_name : VARCHAR(255) NULL&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; region_id : BIGINT UNSIGNED NULL → regions.id (ON DELETE SET NULL)&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; idx_sites_region_id (region_id)&lt;br&gt;created_at / updated_at : TIMESTAMP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="40" width="420" height="180" as="geometry" /></mxCell>
        <mxCell id="d1_smm" value="&lt;b&gt;site_monthly_metrics&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id : BIGINT UNSIGNED AUTO_INCREMENT&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; site_id : BIGINT UNSIGNED NOT NULL → sites.id (ON DELETE CASCADE)&lt;br&gt;bulan : TINYINT NOT NULL (1–12)&lt;br&gt;tahun : SMALLINT NOT NULL&lt;br&gt;revenue : DECIMAL(15,2) NOT NULL DEFAULT 0&lt;br&gt;cost : DECIMAL(15,2) NOT NULL DEFAULT 0&lt;br&gt;profit_loss : DECIMAL(15,2) NOT NULL DEFAULT 0 — dihitung saat import: revenue − cost&lt;br&gt;is_anomaly : BOOLEAN NOT NULL DEFAULT FALSE — true bila revenue = INT32 max (29 baris)&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; smm_site_period_unique (site_id, bulan, tahun)&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; smm_period_index (bulan, tahun) — agregasi dashboard per periode&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; smm_site_year_index (site_id, tahun) — histori per site&lt;br&gt;created_at / updated_at : TIMESTAMP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="470" height="320" as="geometry" /></mxCell>
        <mxCell id="d1_note" value="&lt;b&gt;Aturan bisnis (domain PnL)&lt;/b&gt;&lt;hr&gt;• Status per site per bulan: profit_loss &gt; 0 → Profit; ≤ 0 → Loss.&lt;br&gt;• Site tanpa baris metrik di periode tsb → Tidak Aktif (bukan kolom, tapi turunan).&lt;br&gt;• is_anomaly = true: baris TETAP ada, hanya ditandai; agregat keuangan (SUM revenue/cost/PnL) mengecualikannya, jumlah site Profit/Loss tetap mengikutkan.&lt;br&gt;• Skala: ±17.286 sites, ±294.282 baris metrik (18 periode).&lt;br&gt;• profit_loss TIDAK diisi manual — dihitung otomatis saat import (revenue − cost)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="430" height="200" as="geometry" /></mxCell>
        <mxCell id="d1_e1" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERone;endArrow=ERmany;strokeColor=#6c8ebf;" edge="1" parent="1" source="d1_regions" target="d1_sites"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d1_e2" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERone;endArrow=ERmany;strokeColor=#6c8ebf;" edge="1" parent="1" source="d1_sites" target="d1_smm"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p2" name="2. PO HQ dan Audit Trail">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
