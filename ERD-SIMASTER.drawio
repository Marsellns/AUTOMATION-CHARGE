        <mxCell id="d2_actlog" value="&lt;b&gt;activity_log&lt;/b&gt;  (spatie/activitylog v5)&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id : BIGINT UNSIGNED AUTO_INCREMENT&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; log_name : VARCHAR(255) NULL&lt;br&gt;description : TEXT NOT NULL — created / updated / deleted&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; subject_type : VARCHAR(255) NULL  (morph 'subject')&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; subject_id : BIGINT UNSIGNED NULL — misal PoHq&lt;br&gt;event : VARCHAR(255) NULL&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; causer_type : VARCHAR(255) NULL  (morph 'causer')&lt;br&gt;&lt;b&gt;IDX&lt;/b&gt; causer_id : BIGINT UNSIGNED NULL → users.id&lt;br&gt;attribute_changes : JSON NULL — nilai sebelum/sesudah&lt;br&gt;properties : JSON NULL&lt;br&gt;created_at / updated_at : TIMESTAMP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="40" width="440" height="280" as="geometry" /></mxCell>
        <mxCell id="d2_users" value="&lt;b&gt;users&lt;/b&gt;  (lihat tab 3 untuk detail)&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id : BIGINT UNSIGNED&lt;br&gt;name / email / password&lt;br&gt;&lt;i&gt;Sebagai causer pada audit trail.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="440" height="110" as="geometry" /></mxCell>
        <mxCell id="d2_e1" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERone;endArrow=ERmany;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="d2_pohq" target="d2_actlog"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d2_e2" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERone;endArrow=ERmany;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="d2_users" target="d2_actlog"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
